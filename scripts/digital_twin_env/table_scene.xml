<mujoco model="linnmon_adils_table_scene">
  <!-- IKEA LINNMON / ADILS table (Article 092.464.08, white) + floor.
       Isolated environment component for the SO-101 real-to-sim digital
       twin. No robot, no objects — those are added in later scene files
       that build on top of this one. -->

  <compiler angle="radian" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <material name="table_white_mat" rgba="0.92 0.92 0.90 1" specular="0.15" shininess="0.2" reflectance="0.05"/>
    <material name="floor_mat" rgba="0.55 0.55 0.55 1" specular="0.05" shininess="0.0"/>
  </asset>

  <default>
    <default class="table_collision">
      <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.01 0.001" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <worldbody>
    <light name="top_light" pos="0 0 2.5" dir="0 0 -1" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" castshadow="true"/>

    <camera name="table_view" pos="1.6 -1.6 1.3" xyaxes="0.707 0.707 0 -0.4 0.4 0.82"/>

    <!-- Floor: static plane at Z = 0 -->
    <geom name="floor" type="plane" size="2.5 2.5 0.05" pos="0 0 0" material="floor_mat" class="table_collision"/>

    <!-- IKEA LINNMON / ADILS table, static.
         Tabletop top surface at Z = 0.74 m (0.725 center + 0.015 half-thickness). -->
    <body name="table" pos="0 0 0">

      <geom name="tabletop" type="box" size="0.50 0.30 0.015" pos="0 0 0.725"
            material="table_white_mat" class="table_collision"/>

      <!-- Four ADILS-style cylindrical legs, inset from tabletop edges,
           running from the floor (Z=0) up to just under the tabletop
           (Z=0.71), radius 0.025 m. -->
      <geom name="table_leg_front_left" type="cylinder" size="0.025 0.355" pos="0.42 0.22 0.355"
            material="table_white_mat" class="table_collision"/>
      <geom name="table_leg_front_right" type="cylinder" size="0.025 0.355" pos="0.42 -0.22 0.355"
            material="table_white_mat" class="table_collision"/>
      <geom name="table_leg_back_left" type="cylinder" size="0.025 0.355" pos="-0.42 0.22 0.355"
            material="table_white_mat" class="table_collision"/>
      <geom name="table_leg_back_right" type="cylinder" size="0.025 0.355" pos="-0.42 -0.22 0.355"
            material="table_white_mat" class="table_collision"/>

    </body>
  </worldbody>
</mujoco>
