<mujoco model="linnmon_adils_spawn_cube_scene">
  <!-- Runtime cube-spawning experiment. Reuses the LINNMON/ADILS table
       definition from ../table_scene.xml (copied here, not modified —
       that file is left untouched) and adds exactly one free-jointed
       cube for testing runtime respawn via qpos/qvel edits.

       NOTE: table_scene.xml is a full standalone <mujoco> document (its
       own <worldbody>/<asset>/<default>), so MuJoCo <include> can't
       nest it inside this file's <worldbody> without a structure
       conflict -- the table geometry below is a clean copy instead. -->

  <compiler angle="radian" autolimits="true"/>

  <option gravity="0 0 -9.81" timestep="0.002"/>

  <visual>
    <headlight diffuse="0.3 0.3 0.3" ambient="0.4 0.4 0.4" specular="0.1 0.1 0.1"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <material name="table_white_mat" rgba="0.92 0.92 0.90 1" specular="0.15" shininess="0.2" reflectance="0.05"/>
    <material name="floor_mat" rgba="0.55 0.55 0.55 1" specular="0.05" shininess="0.0"/>
    <material name="cube_mat" rgba="0.95 0.55 0.05 1" specular="0.3" shininess="0.3"/>
  </asset>

  <default>
    <default class="table_collision">
      <geom contype="1" conaffinity="1" condim="3" friction="0.6 0.01 0.001" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </default>
    <default class="cube_collision">
      <geom contype="1" conaffinity="1" condim="4" friction="0.8 0.02 0.001" solref="0.005 1" solimp="0.95 0.99 0.001"/>
    </default>
  </default>

  <worldbody>
    <light name="top_light" pos="0 0 2.5" dir="0 0 -1" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1" castshadow="true"/>

    <camera name="table_view" pos="1.6 -1.6 1.3" xyaxes="0.707 0.707 0 -0.4 0.4 0.82"/>

    <!-- Floor: static plane at Z = 0 -->
    <geom name="floor" type="plane" size="2.5 2.5 0.05" pos="0 0 0" material="floor_mat" class="table_collision"/>

    <!-- IKEA LINNMON / ADILS table, static. Copied from table_scene.xml. -->
    <body name="table" pos="0 0 0">

      <geom name="tabletop" type="box" size="0.50 0.30 0.015" pos="0 0 0.725"
            material="table_white_mat" class="table_collision"/>

      <geom name="table_leg_front_left" type="cylinder" size="0.025 0.355" pos="0.42 0.22 0.355"
            material="table_white_mat" class="table_collision"/>
      <geom name="table_leg_front_right" type="cylinder" size="0.025 0.355" pos="0.42 -0.22 0.355"
            material="table_white_mat" class="table_collision"/>
      <geom name="table_leg_back_left" type="cylinder" size="0.025 0.355" pos="-0.42 0.22 0.355"
            material="table_white_mat" class="table_collision"/>
      <geom name="table_leg_back_right" type="cylinder" size="0.025 0.355" pos="-0.42 -0.22 0.355"
            material="table_white_mat" class="table_collision"/>

    </body>

    <!-- Free-falling test cube. Initial spawn: x=0, y=0, z=1.0, well above
         the tabletop (top surface at Z=0.74), so it falls under gravity
         and collides with the table on its own -- not manually placed at
         rest. -->
    <body name="cube" pos="0 0 1.0">
      <freejoint name="cube_freejoint"/>
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" mass="0.05"
            material="cube_mat" class="cube_collision"/>
    </body>
  </worldbody>
</mujoco>
