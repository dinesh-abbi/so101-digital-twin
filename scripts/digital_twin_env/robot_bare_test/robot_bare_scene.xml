<mujoco model="so101_bare_scene">
  <!-- Robot on the standard MuJoCo groundplane -- no table.

       WHY THIS EXISTS: the table scenes have an unresolved ~5-7 cm
       mismatch between where the sim's tabletop sits and where the real
       arm's workspace actually is, so poses the real arm reaches cleanly
       put the sim gripper below the modeled surface. Excluding table
       contact hides it; making the table solid contorts the arm (up to
       126 deg of joint error, measured across a 40x contact-stiffness
       sweep -- the position actuators simply overpower any contact).

       Here the robot's base sits ON the groundplane, so there is no
       table-height question at all and nothing needs excluding. Use
       robot_corner_scene.xml when the table itself matters (object
       parity, dataset framing). -->

  <compiler angle="radian" autolimits="true" meshdir="../../../so101_assets/assets"/>

  <include file="../../../so101_assets/so101.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="140" elevation="-20"/>
    <quality shadowsize="4096"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7"
             rgb2="0 0 0" width="512" height="3072"/>
    <!-- Solid, non-reflective floor (2026-09-16) -- the checker+reflectance
         groundplane made it hard to see where the gripper actually met the
         floor during cube_mark_test work, since the reflection looked like
         a second, lower surface. -->
    <material name="groundplane" rgba="0.22 0.24 0.28 1" reflectance="0"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>
  </worldbody>
</mujoco>
